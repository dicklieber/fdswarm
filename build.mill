  val log4j = "2.25.5"
  val jackson = "2.18.12"
  val tapir = "1.13.8"
  val http4s = "0.23.38"

object common extends CommonSettings with BuildInfo:
  def scalaVersion = Versions.scala

  def buildInfoPackageName = "com.organization"

  def buildInfoMembers = Seq(
    BuildInfo.Value("appName", appName),
    BuildInfo.Value("productName", productName),
    BuildInfo.Value("version", version),
    BuildInfo.Value("buildNumber", buildNumber),
    BuildInfo.Value("displayVersion", displayVersion),
    BuildInfo.Value("majorVersion", majorVersion),
    BuildInfo.Value("scalaVersion", scalaVersion()),
    BuildInfo.Value("dataVersion", majorVersion)
  )

  def mvnDeps = Seq(
    mvn"io.circe::circe-core:0.14.10",
    mvn"io.circe::circe-generic:0.14.10",
    mvn"io.circe::circe-parser:0.14.10",
    mvn"com.softwaremill.sttp.tapir:tapir-core_3:${Versions.tapir}",
    mvn"org.apache.logging.log4j:log4j-api:${Versions.log4j}",
    mvn"org.apache.commons:commons-text:1.10.0",
    // CVE-2025-48924: override Commons Text's older transitive version.
    mvn"org.apache.commons:commons-lang3:3.18.0",
    mvn"com.lihaoyi::os-lib:0.11.6",
    scalaFxDep,
    mvn"jakarta.inject:jakarta.inject-api:2.0.1",
    mvn"com.typesafe:config:1.4.3",
    mvn"org.scala-lang.modules::scala-xml:2.2.0",
    mvn"com.lihaoyi::mainargs:0.7.8",
    mvn"io.dropwizard.metrics5:metrics-core:5.0.4",
    mvn"io.dropwizard.metrics5:metrics-jvm:5.0.4"
  )

  object test extends ScalaTests with TestModule.Munit:
    override def mvnDeps = super.mvnDeps() ++ Seq(
      mvn"org.scalameta::munit:1.0.3"
    )

object fdswarm
    extends CommonSettings
    with ScoverageModule
    with FdSwarmPackaging:

  def scalaVersion = Versions.scala

  override def moduleDeps = Seq(common)

  def generatedDocsSite = Task {
    docs.site()
  }

  override def resources = Task {
    val generatedDocs = generatedDocsSite().path
    val docsResources =
      if os.exists(generatedDocs) then
        val staged = Task.dest / "FDSwarmDocs"
        os.copy.over(generatedDocs, staged, createFolders = true)
        Seq(PathRef(Task.dest))
      else
        Seq.empty

    super.resources() ++ docsResources
  }

  override def docSources = Task {
    super.docSources() ++ Seq(common.compile().classes)
  }

  def mainClass = Some("fdswarm.FdSwarm")

  override def manifest = Task {
    super
      .manifest()
      .add(
        "Implementation-Title" -> appName,
        "Implementation-Version" -> version,
        "Implementation-Build" -> buildNumber,
        "Bundle-Name" -> appName,
        "Bundle-SymbolicName" -> productName,
        "Bundle-Version" -> version
      )
  }

  def scoverageVersion = "2.1.1"

  /** Preserve the release JAR's manifest/resources while replacing app classes with
    * their instrumented counterparts. Scala 3's coverage runtime is in scala-library.
    */
  def integrationCoverageAssembly = Task {
    val application = assembly().path
    val instrumented = scoverage.compile().classes.path
    val destination = Task.dest / "fdswarm-coverage.jar"
    val replacements = os.walk(instrumented).filter(os.isFile(_)).map { path =>
      path.relativeTo(instrumented).toString -> path
    }.toMap
    // Mill prepends a shell launcher to its assembly. The JDK jar update command
    // does not preserve that archive, so create a standard runnable JAR directly.
    scala.util.Using.resources(new java.util.zip.ZipFile(application.toIO),
      new java.util.zip.ZipOutputStream(java.nio.file.Files.newOutputStream(destination.toIO.toPath))) { (input, output) =>
      input.entries().asScala.filterNot(entry => replacements.contains(entry.getName)).foreach { entry =>
        output.putNextEntry(new java.util.zip.ZipEntry(entry.getName))
        if !entry.isDirectory then
          scala.util.Using.resource(input.getInputStream(entry))(_.transferTo(output))
        output.closeEntry()
      }
      replacements.toSeq.sortBy(_._1).foreach { (name, path) =>
        output.putNextEntry(new java.util.zip.ZipEntry(name))
        java.nio.file.Files.copy(path.toIO.toPath, output)
        output.closeEntry()
      }
    }
    PathRef(destination)
  }

  def mvnDeps = Seq(
    mvn"org.apache.logging.log4j:log4j-api:${Versions.log4j}",
    mvn"org.apache.logging.log4j:log4j-core:${Versions.log4j}",
    mvn"org.apache.logging.log4j:log4j-slf4j2-impl:${Versions.log4j}",
    mvn"org.apache.logging.log4j:log4j-layout-template-json:${Versions.log4j}",
    mvn"com.fasterxml.jackson.core:jackson-databind:${Versions.jackson}",
    mvn"com.fasterxml.jackson.dataformat:jackson-dataformat-yaml:${Versions.jackson}",
    mvn"com.typesafe.scala-logging::scala-logging:3.9.5",
    mvn"org.slf4j:slf4j-api:2.0.16",
    mvn"io.github.classgraph:classgraph:4.8.179",
    mvn"net.codingwell::scala-guice:7.0.0",
    mvn"com.google.inject:guice:7.0.0",
    // CVE-2023-2976: override Guice's older transitive version.
    mvn"com.google.guava:guava:32.0.1-jre",
    mvn"com.google.inject.extensions:guice-assistedinject:7.0.0",
    mvn"com.github.andyglow::typesafe-config-scala:2.0.0",
    mvn"io.circe::circe-core:0.14.10",
    mvn"io.circe::circe-generic:0.14.10",
    mvn"io.circe::circe-parser:0.14.10",
    mvn"com.softwaremill.sttp.tapir:tapir-core_3:${Versions.tapir}",
    mvn"com.softwaremill.sttp.tapir:tapir-http4s-server_3:${Versions.tapir}",
    mvn"com.softwaremill.sttp.tapir:tapir-http4s-client_3:${Versions.tapir}",
    mvn"com.softwaremill.sttp.tapir:tapir-json-circe_3:${Versions.tapir}",
    mvn"com.softwaremill.sttp.tapir::tapir-swagger-ui-bundle:${Versions.tapir}",
    mvn"org.http4s:http4s-ember-server_3:${Versions.http4s}",
    mvn"org.http4s:http4s-ember-client_3:${Versions.http4s}",
    mvn"org.http4s:http4s-dsl_3:${Versions.http4s}",
    mvn"org.http4s:http4s-circe_3:${Versions.http4s}",
    mvn"org.typelevel:cats-effect_3:3.5.7",
    // JavaFX comes from the Liberica Full JDK, as it does for ScalaFX.
    mvn"com.dlsc.gemsfx:gemsfx:4.5.0".exclude(
      "org.openjfx" -> "javafx-base",
      "org.openjfx" -> "javafx-controls",
      "org.openjfx" -> "javafx-fxml",
      "org.openjfx" -> "javafx-graphics",
      "org.openjfx" -> "javafx-media",
      "org.openjfx" -> "javafx-swing",
      "org.openjfx" -> "javafx-web"
    ),
    scalaFxDep,
    mvn"org.scala-lang.modules::scala-xml:2.3.0",
    mvn"org.typelevel::otel4s-oteljava:0.16.0-M1",
    mvn"com.lihaoyi::mainargs:0.7.8"
  )

  object test extends ScoverageTests with TestModule.Munit:
    override def mvnDeps = super.mvnDeps() ++ Seq(
      mvn"org.apache.logging.log4j:log4j-core:${Versions.log4j}",
      mvn"org.apache.logging.log4j:log4j-core-test:${Versions.log4j}",
      mvn"org.mockito:mockito-core:4.11.0",
      mvn"org.objenesis:objenesis:3.3",
      mvn"com.softwaremill.sttp.tapir:tapir-http4s-client_3:${Versions.tapir}",
      mvn"org.http4s:http4s-ember-client_3:${Versions.http4s}"
    )

    def scalaVersion = Versions.scala
    def munitVersion = "1.0.0"
    override def testReportXml = Some("test-report.xml")
    override def forkWorkingDir = Task { moduleDir / os.up / os.up }
    override def testSandboxWorkingDir = false


